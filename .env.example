# Pastra environment configuration (see docs/architecture.md section 15).
# Copy to .env for local development. Never commit real secrets.

# --- Core ---
APP_URL=http://localhost:3000
DATABASE_URL=postgres://pastra:pastra@localhost:5432/pastra
SESSION_SECRET=dev-session-secret-change-me
# Comma-separated list of versioned keys: "v1:<base64-32-bytes>,v2:<base64-32-bytes>"
TOKEN_ENC_KEYS=v1:00000000000000000000000000000000000000000000
HMAC_KEY=dev-hmac-key-change-me

# --- Weekly drop ---
DROP_CRON=0 13 * * 1
DROP_TZ=Europe/Warsaw
DROP_PREPARE_HOURS=24
OFFERS_PER_USER=8
OFFERS_PER_AXIS=3

# --- Card (Wirex) ---
CARD_PROVIDER=mock
WIREX_API_URL=https://api-baas.wirexapp.tech
WIREX_API_KEY=
WIREX_WEBHOOK_SECRET=
CARD_DEFAULT_DAILY_LIMIT=
CARD_INACTIVE_DAYS=90

# --- Feature flags (default off) ---
CASHBACK_PAYOUT_ENABLED=false
PHONE_WALLET_ENABLED=false
PROVIDERS_LIVE=steam,twitch,discord,wallet_evm,telegram
ADMIN_USERS=

# --- Blockchain indexers ---
ALCHEMY_KEY=
HELIUS_KEY=
TONAPI_KEY=
EVM_CHAINS=ethereum,base,arbitrum,optimism,polygon,bnb,avalanche,zksync

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MAIL_API_KEY=
MAIL_FROM=hello@[your-domain]

# --- Observability ---
SENTRY_DSN=
POSTHOG_KEY=

# --- Service OAuth credentials (add per provider as enabled) ---
STEAM_WEB_API_KEY=
X_DAILY_SPEND_CAP=
APPLE_MUSIC_KEY=
