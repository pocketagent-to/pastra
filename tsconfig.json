{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@pastra/config": ["packages/config/src/index.ts"],
      "@pastra/catalog": ["packages/catalog/src/index.ts"],
      "@pastra/scoring": ["packages/scoring/src/index.ts"],
      "@pastra/crypto": ["packages/crypto/src/index.ts"],
      "@pastra/db": ["packages/db/src/index.ts"],
      "@pastra/card": ["packages/card/src/index.ts"],
      "@pastra/providers": ["packages/providers/src/index.ts"],
      "@pastra/notify": ["packages/notify/src/index.ts"],
      "@pastra/core": ["packages/core/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts"],
  "exclude": ["node_modules", "**/dist/**", "apps/**"]
}
