{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @pastra/web build"
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @pastra/db migrate",
    "startCommand": "pnpm --filter @pastra/web start",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
